# ============================================================
#  Macca Toàn Thắng — Environment Variables (MẪU)
#  Sao chép file này thành .env và điền giá trị thật
#  KHÔNG commit file .env lên Git!
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
# Mật khẩu database (đặt mạnh, ít nhất 20 ký tự)
DB_PASSWORD=

# ── Admin Panel ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── JWT Secret ───────────────────────────────────────────────
# Tạo bằng lệnh: openssl rand -hex 32
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────
PUBLIC_ORIGIN=https://maccatoanthang.com,https://www.maccatoanthang.com

# ── GitHub Container Registry ────────────────────────────────
# Định dạng: github_username/ten_repo
# Ví dụ: nguyenvana/maccatoanthang
GITHUB_REPOSITORY=

# ── Seed Data ────────────────────────────────────────────────
# true  = tạo dữ liệu mẫu (chỉ dùng lần đầu deploy)
# false = bỏ qua seed (dùng sau khi đã có data thật)
SEED_ENABLED=true
